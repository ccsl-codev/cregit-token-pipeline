[run]
branch = True
source = .
omit =
    .venv/*
    tests/*
    */__pycache__/*
    setup.py

[report]
# run_tests.sh fails a run below this floor.
fail_under = 80
show_missing = True
skip_covered = False
precision = 1
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
