__pycache__/
*.pyc
ctp.duckdb
runs.log
metrics.tsv
resources.tsv
smoke-*.log
corpus-*.log

# Per-project run state: logs/ and the single-instance lock, one directory per
# project. Derived from a run. It lives here rather than in the project workdir
# because run_pipeline_process.sh deletes that workdir (see STATE in ctp.py).
state/

# Test environment and coverage output. run_tests.sh rebuilds the first; the rest
# are derived from a run.
.venv/
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Left behind by `pip install -e '.[dev]'` and by CI's --junitxml. Both are
# derived from pyproject.toml and a run.
*.egg-info/
junit-*.xml

# Caches. Rebuilt by `build_domain_map.py fetch`. Large, machine-specific and
# derived from public APIs, so they are reproducible rather than source.
.corpus-cache/

# Third-party source data, 29 MB. The DOI is stable and sources/README.md
# records every field, so the repo documents the fetch instead of copying the
# payload. See sources/README.md for the archive and its layout.
sources/*.tar.gz
sources/*.txt

# Inputs a user supplies, and output derived from a run. Not source, and this
# repository ships no script that produces them: write your own manifest, and
# your own provenance sidecar in the format documented in validate_schema.py
# above EXPECTED_COLUMNS.
candidates.csv
manifest.generated.tsv
project_meta.json

# TRACKED ON PURPOSE, do not add these here:
#   data/affiliation.merged.csv   the firm map, with provenance per row
#   sources/README.md             field definitions for the third-party data
